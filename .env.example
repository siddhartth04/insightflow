# ---------------------------------------------------------------------------
# InsightFlow -- copy to .env and fill in a provider key.
#   cp .env.example .env
# .env is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Model (routed through LiteLLM) ----------------------------------------
# Any provider LiteLLM supports works; set the matching key below.
#   groq/openai/gpt-oss-120b     openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-5  gemini/gemini-2.0-flash
LLM_MODEL=groq/openai/gpt-oss-120b

LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120

# --- Provider credentials --------------------------------------------------
# Set the one matching LLM_MODEL. Leave the rest blank.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Service URLs (container-to-container; never localhost) ----------------
RESEARCH_SERVICE_URL=http://research:8001
CONTENT_SERVICE_URL=http://content:8002
RESEARCH_TIMEOUT=180

# --- LiteLLM proxy (optional) ----------------------------------------------
# Leave blank to have the services call the provider directly, which is the
# default. Set to http://litellm:4000 to route through the bundled proxy.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# --- Misc -------------------------------------------------------------------
CORS_ORIGINS=*
# Set to true to force deterministic preview output even when a key is present.
OFFLINE_MODE=
