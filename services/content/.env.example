# --- LLM (via LiteLLM) ---------------------------------------------------
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120

# Provider key. Any provider LiteLLM supports works; set the matching key.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: route through the bundled LiteLLM proxy instead of calling the
# provider directly. Docker Compose sets this to http://litellm:4000.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# --- Service -------------------------------------------------------------
CONTENT_PORT=8002
CORS_ORIGINS=*

# Cross-module dependency. Docker Compose sets this to http://research:8001.
RESEARCH_SERVICE_URL=http://localhost:8001
RESEARCH_TIMEOUT=180

# Force deterministic preview output even when a key is present.
OFFLINE_MODE=
